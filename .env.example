# Set a unique random admin password before opening the browser control room.
# Use at least 32 random characters. Do not reuse an Instagram password.
IG_ADMIN_PASSWORD=

# These can stay blank if you configure the bot from the browser control room.
# Keep saved settings and this file private; never publish credentials.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Sending stays disabled until your Meta app and access token are ready.
IG_AUTOMATION_ENABLED=false
IG_POLL_ENABLED=true
IG_POLL_INTERVAL_SECONDS=60
META_API_VERSION=v26.0
PUBLIC_REPLY_TEXT=send it
PRIVATE_REPLY_TEXT=dm worked!

# Local-only default. Use 0.0.0.0:3000 only behind a firewall/reverse proxy.
IG_REPLY_BIND_ADDR=127.0.0.1:3000
IG_DATABASE_PATH=ig_reply_bot.sqlite3
IG_KEYWORD=бот
