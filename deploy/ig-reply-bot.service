[Unit]
Description=Instagram comment reply bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
UMask=0077
User=ig-reply-bot
Group=ig-reply-bot
WorkingDirectory=/var/lib/ig-reply-bot
StateDirectory=ig-reply-bot
EnvironmentFile=/etc/ig-reply-bot/ig-reply-bot.env
Environment=IG_REPLY_BIND_ADDR=127.0.0.1:3000
Environment=IG_DATABASE_PATH=/var/lib/ig-reply-bot/queue.sqlite3
ExecStart=/opt/ig-reply-bot/ig-reply-bot
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/ig-reply-bot

[Install]
WantedBy=multi-user.target
